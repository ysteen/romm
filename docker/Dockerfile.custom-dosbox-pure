ARG ROMM_BASE_IMAGE=ghcr.io/rommapp/romm:4.9.2
FROM node:24-alpine AS frontend-build
WORKDIR /front
COPY frontend/package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM ${ROMM_BASE_IMAGE}

COPY --from=frontend-build /front/dist/ /var/www/html/

# This DOSBox Pure build declares minimumEJSVersion 4.3.0. Overlay the complete
# matching 4.3 frontend as one coherent set; mixing its ESM loader/GameManager
# with RomM's bundled EmulatorJS 4.2.3 classic scripts breaks initialization.
COPY custom-emulatorjs/data/ /var/www/html/assets/emulatorjs/data/
