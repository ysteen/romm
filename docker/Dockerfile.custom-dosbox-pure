ARG ROMM_BASE_IMAGE=ghcr.io/rommapp/romm:4.9.2
FROM node:24-alpine AS frontend-build
WORKDIR /front
COPY frontend/package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM ${ROMM_BASE_IMAGE}

COPY --from=frontend-build /front/dist/ /var/www/html/

# This DOSBox Pure build declares minimumEJSVersion 4.3.0. Overlay the complete
# matching 4.3 ESM frontend as one coherent set. The custom loader deliberately
# uses src/emulator.js; remove RomM's bundled 4.2.3 classic minified files so a
# future loader change cannot silently mix the two incompatible generations.
COPY custom-emulatorjs/data/ /var/www/html/assets/emulatorjs/data/
RUN rm -f \
    /var/www/html/assets/emulatorjs/data/emulator.min.js \
    /var/www/html/assets/emulatorjs/data/emulator.min.css
