+/* Versioned, little-endian APU scheduling state omitted by the core save format. */
+#define ROLLBACK_TRAILER_SIZE 48
+static void rollback_write_u32(uint8_t *data, uint32_t value)
+{
+    for (unsigned i = 0; i < 4; i++) data[i] = value >> (8 * i);
+}
+
+static uint32_t rollback_read_u32(const uint8_t *data)
+{
+    uint32_t value = 0;
+    for (unsigned i = 0; i < 4; i++) value |= (uint32_t)data[i] << (8 * i);
+    return value;
+}
+
