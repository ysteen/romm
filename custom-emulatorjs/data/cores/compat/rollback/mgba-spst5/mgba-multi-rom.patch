+static void _clearRoms(void) {
+	for (unsigned i = 0; i < SP_MAX_PLAYERS; ++i) {
+		free(romCopies[i]);
+		romCopies[i] = NULL;
+		romSizes[i] = 0;
+	}
+	romCount = 0;
+}
+
+static bool _copyRoms(const struct retro_game_info* games, unsigned count) {
+	_clearRoms();
+	pendingLoad = false;
+	menuActive = false;
+	if (!games || !count || count > SP_MAX_PLAYERS) return false;
+	for (unsigned i = 0; i < count; ++i) {
+		if (!games[i].data || !games[i].size || games[i].size > 32 * 1024 * 1024) {
+			_clearRoms();
+			return false;
+		}
+		romCopies[i] = malloc(games[i].size);
+		if (!romCopies[i]) {
+			_clearRoms();
+			return false;
+		}
+		romSizes[i] = games[i].size;
+		memcpy(romCopies[i], games[i].data, games[i].size);
+	}
+	romCount = count;
+	return true;
+}
+
+static bool _doLoad(int nPlayers) {
+	const void* data[SP_MAX_PLAYERS];
+	size_t sizes[SP_MAX_PLAYERS];
+	if (nPlayers < 1 || nPlayers > SP_MAX_PLAYERS || !romCount ||
+	    (romCount != 1 && romCount != (unsigned) nPlayers)) return false;
+	for (int i = 0; i < nPlayers; ++i) {
+		unsigned slot = romCount == 1 ? 0 : (unsigned) i;
+		data[i] = romCopies[slot];
+		sizes[i] = romSizes[slot];
+	}
+	if (!sp_load_roms(&sp, nPlayers, data, sizes, &vid)) {
 		return false;
 	}
