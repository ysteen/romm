+void GBASIOLockstepCoordinatorCableChanged(struct GBASIOLockstepCoordinator* coordinator) {
+	MutexLock(&coordinator->mutex);
+	coordinator->waiting = 0;
+	coordinator->transferActive = false;
+	memset(coordinator->multiData, 0xFF, sizeof(coordinator->multiData));
+	memset(coordinator->normalData, 0xFF, sizeof(coordinator->normalData));
+	for (int i = 0; i < coordinator->nAttached; ++i) {
+		struct GBASIOLockstepPlayer* player = TableLookup(&coordinator->players, coordinator->attachedPlayers[i]);
+		/* Pending transfers refer to the previous cable's wire IDs. */
+		player->queue = NULL;
+		player->dataReceived = false;
+		for (unsigned j = 0; j < MAX_LOCKSTEP_EVENTS; ++j)
+			player->buffer[j].next = j + 1 < MAX_LOCKSTEP_EVENTS ? &player->buffer[j + 1] : NULL;
+		player->freeList = player->buffer;
+		for (int j = 0; j < MAX_GBAS; ++j) {
+			struct GBASIOLockstepPlayer* other = TableLookup(&coordinator->players, coordinator->attachedPlayers[j]);
+			_setReady(coordinator, player, j, other ? other->mode : (enum GBASIOMode) -1);
+		}
+		GBASIOLockstepPlayerWake(player);
+	}
+	MutexUnlock(&coordinator->mutex);
+}
