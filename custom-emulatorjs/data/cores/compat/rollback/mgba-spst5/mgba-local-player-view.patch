@@ -61,6 +61,30 @@
 static bool limiterOpt = true;   /* audio post: soft-knee limiter */
 static unsigned advertisedRate; /* audio rate last sent via SET_SYSTEM_AV_INFO */
 static bool coreOptionsChanged; /* option visibility changed since last poll */
+
+static int localPlayerView = -1;
+static unsigned localViewPoll;
+
+static void _applyLocalPlayerView(void) {
+#ifdef _WIN32
+	const wchar_t* path = _wgetenv(L"ROMM_NETPLAY_PLAYER_FILE");
+	if (!path || !*path) return;
+	if (localPlayerView < 0) localPlayerView = 0;
+	if ((localViewPoll++ % 15) == 0) {
+		FILE* file = _wfopen(path, L"rb");
+		if (file) {
+			int value = fgetc(file);
+			fclose(file);
+			if (value >= '0' && value <= '4') localPlayerView = value - '0';
+		}
+	}
+	/* Display preferences stay outside serialized emulation state. */
+	layoutOpt = SP_LAYOUT_FOCUS;
+	focusedOpt = localPlayerView > 0 ? localPlayerView - 1 : 0;
+	audioOpt = (enum spAudio) focusedOpt;
+	overlaysOpt = false;
+#endif
+}
 
