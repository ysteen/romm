# Copy to deploy/.env, or run scripts/deploy-dosbox-pure.sh to generate it.
DB_ROOT_PASSWORD=replace-with-a-random-secret
DB_PASSWORD=replace-with-a-random-secret
ROMM_AUTH_SECRET_KEY=replace-with-a-64-character-random-secret
ROMM_PORT=8080
ROMM_DATA_DIR=./deploy-data
# Leave these empty to use the published defaults from Compose.
# Set both to matching sha-<commit> tags or digests to pin an exact build.
ROMM_IMAGE=
ROMFORGE_IMAGE=
HASHEOUS_API_ENABLED=true
TZ=Asia/Seoul

# Keep Windows/DOS playback on the custom DOSBox Pure integration.
DISABLE_JSDOS=true
ROMFORGE_ENABLED=false
